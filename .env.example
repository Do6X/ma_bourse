# Copiez ce fichier en ".env" pour un usage LOCAL uniquement (ne jamais
# committer un ".env" rempli). En déploiement (Render, Fly.io, etc.), ces
# variables se configurent dans le tableau de bord de la plateforme, pas ici.

# Clé Financial Modeling Prep (regénérez une clé neuve : l'ancienne a
# transité en clair dans une conversation et doit être considérée compromise)
FMP_API_KEY=

# Optionnelle : sans elle, le sentiment de marché reste "Neutre" par défaut
NEWSAPI_KEY=

# Optionnel, pour le chiffrement local des clés (voir secrets_util.py) :
# inutile sur une plateforme comme Render qui chiffre déjà les variables
# d'environnement à sa façon — les deux variables ci-dessus suffisent alors.
APP_MASTER_KEY=
